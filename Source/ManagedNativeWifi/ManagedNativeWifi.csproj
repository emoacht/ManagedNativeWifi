<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;netstandard2.0</TargetFrameworks>
	  <LangVersion>latest</LangVersion>
	  <Version>3.1.0</Version>
	  <Authors>emoacht;Samael7777</Authors>
	  <Title>Managed Native Wifi</Title>
	  <Description>ManagedNativeWifi is a managed implementation of Native Wifi API. It provides functionality to manage wireless networks, interfaces and profiles.</Description>
	  <Copyright>Copyright © 2015 emoacht, Samael777</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://github.com/emoacht/ManagedNativeWifi</PackageProjectUrl>
	  <PackageReleaseNotes>https://github.com/emoacht/ManagedNativeWifi#release-notes</PackageReleaseNotes>
	  <PackageTags>WiFi, Wi-Fi, Wireless-LAN, WLAN</PackageTags>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/emoacht/ManagedNativeWifi</RepositoryUrl>
	  <RepositoryType>Git</RepositoryType>
	  <NeutralLanguage>en-US</NeutralLanguage>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
  <PublishAot>True</PublishAot>
  <PublishTrimmed>True</PublishTrimmed>
  <EnableRuntimeMarshalling>false</EnableRuntimeMarshalling>
</PropertyGroup>

	
  <ItemGroup>
    <InternalsVisibleTo Include="ManagedNativeWifi.Test" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.264">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Condition="'$(TargetFramework)' == 'netstandard2.0'" Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DocumentationFile>bin\Debug\ManagedNativeWifi.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DocumentationFile>bin\Release\ManagedNativeWifi.xml</DocumentationFile>
  </PropertyGroup>
</Project>